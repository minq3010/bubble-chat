{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "pnpm electron:dev",
    "build": "vite build",
    "format": "oxfmt",
    "electron": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "electron:dev": "concurrently -k -n vite,electron \"vite --host 0.0.0.0 --port 8443\" \"wait-on tcp:8443 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_URL=http://localhost:8443 electron .\"",
    "build:mac": "cross-env ELECTRON=1 vite build && electron-builder --mac",
    "build:win": "cross-env ELECTRON=1 vite build && electron-builder --win",
    "build:linux": "cross-env ELECTRON=1 vite build && electron-builder --linux",
    "build:all": "cross-env ELECTRON=1 vite build && electron-builder -mw",
    "electron:build": "cross-env ELECTRON=1 vite build && electron-builder"
  },
  "build": {
    "appId": "com.bubble.desktop",
    "productName": "Bubble",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Network"
    }
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wait-on": "^9.1.0"
  }
}
